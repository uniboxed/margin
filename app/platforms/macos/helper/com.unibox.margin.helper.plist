<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- margin-helper as a login agent (Margin.app registers it: SMAppService.agent; main.swift beside this says what
     it does). In Margin.app's Contents/Library/LaunchAgents, its program the bundle's Contents/Helpers/margin-helper.
     Started again if it ends by a crash (not if it exits cleanly), in the user's graphical session only. -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.unibox.margin.helper</string>
	<key>BundleProgram</key>
	<string>Contents/Helpers/margin-helper</string>
	<key>AssociatedBundleIdentifiers</key>
	<array>
		<string>com.unibox.margin</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>
	<key>LimitLoadToSessionType</key>
	<string>Aqua</string>
	<key>ProcessType</key>
	<string>Interactive</string>
</dict>
</plist>
