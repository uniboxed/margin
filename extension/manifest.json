{
  "manifest_version": 3,
  "name": "Margin",
  "short_name": "Margin",
  "description": "An Arc-style sidebar with spaces, pins, and a command palette.",
  "version": "0.1.0",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png",
    "256": "icons/icon-256.png",
    "512": "icons/icon-512.png"
  },
  "permissions": [
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "shared/view.js",
        "shared/search.js",
        "shared/shortcuts.js",
        "shared/ui.js",
        "content/sidebar.js",
        "content/palette.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "chrome_url_overrides": {
    "newtab": "newtab/newtab.html"
  },
  "commands": {
    "toggle-sidebar": {
      "suggested_key": {
        "default": "Alt+S",
        "mac": "Alt+S"
      },
      "description": "Toggle the Margin sidebar"
    },
    "open-palette": {
      "suggested_key": {
        "default": "Alt+K",
        "mac": "Alt+K"
      },
      "description": "Open the Margin command palette"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "content/sidebar.css",
        "content/palette.css"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
