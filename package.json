{
  "name": "margin",
  "private": true,
  "type": "module",
  "imports": {
    "#engine": {
      "margin-webkit": "./extension/engines/webkit/safari/engine.ts",
      "margin-chromium": "./extension/engines/chromium/engine.ts",
      "default": "./extension/shared/any-engine.ts"
    },
    "#engine/profile": {
      "margin-webkit": "./extension/engines/webkit/safari/profile.ts",
      "margin-chromium": "./extension/engines/chromium/profile.ts",
      "default": "./extension/shared/any-engine-profile.ts"
    }
  },
  "description": "Arc-style sidebar for Safari (prototype)",
  "scripts": {
    "pretest": "node scripts/build.ts",
    "test": "tsc -p . && node --test tests/*.test.ts tests/security/*.test.ts 'extension/engines/**/tests/*.test.ts'",
    "test:security": "node --test tests/theme-sanitize.test.ts tests/theme-guard.test.ts tests/security/*.test.ts && node --test --test-concurrency=1 tests/theme/browser.test.ts tests/theme/security.test.ts",
    "test:e2e": "node scripts/build.ts && node --test --test-concurrency=2 tests/e2e/*.test.ts",
    "test:quick": "node scripts/quick-test.mts",
    "gate": "npm test && npm run test:rust && npm run test:theme && npm run test:security && npm run test:app && npm run test:e2e && npm run test:webkit",
    "test:rust": "scripts/rust-test.sh",
    "test:theme": "node --test --test-concurrency=1 tests/theme/*.test.ts",
    "test:app": "node scripts/build.ts && tools/app-tests/run.sh",
    "bench:theme": "node tests/theme/bench.ts",
    "bench:box": "node scripts/build.ts && node tests/box/bench.mts",
    "bench:sites": "node scripts/build.ts && node tests/box/sites-bench.mts",
    "icons": "node scripts/make-icons.ts",
    "build": "node scripts/build.ts",
    "theme:pack": "node scripts/pack-theme.ts",
    "typecheck": "tsc -p .",
    "test:webkit": "node scripts/build.ts && tools/webkit-host/run.sh all",
    "safari": "sh scripts/safari.sh",
    "log:app": "scripts/margin-log.sh",
    "fit-check": "node tools/fit-check/nightly.mts"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "playwright": "1.63.0",
    "typescript": "7.0.2"
  }
}
