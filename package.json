{
  "name": "margin",
  "private": true,
  "type": "module",
  "description": "Arc-style sidebar for Safari (prototype)",
  "scripts": {
    "pretest": "node scripts/build.js",
    "test": "tsc -p . && node --test tests/*.test.js tests/security/*.test.js",
    "test:security": "node --test tests/theme-sanitize.test.js tests/theme-guard.test.js tests/security/*.test.js && node --test --test-concurrency=1 tests/theme/browser.test.js tests/theme/security.test.js",
    "test:e2e": "node scripts/build.js && node --test --test-concurrency=2 tests/e2e/*.test.js",
    "test:quick": "node scripts/quick-test.mjs",
    "gate": "npm test && npm run test:theme && npm run test:security && npm run test:app && npm run test:e2e && npm run test:webkit",
    "test:theme": "node --test --test-concurrency=1 tests/theme/*.test.js",
    "test:app": "node scripts/build.js && tools/app-tests/run.sh",
    "bench:theme": "node tests/theme/bench.js",
    "bench:box": "node scripts/build.js && node tests/box/bench.mjs",
    "icons": "node scripts/make-icons.js",
    "build": "node scripts/build.js",
    "theme:pack": "node scripts/pack-theme.js",
    "typecheck": "tsc -p .",
    "test:webkit": "node scripts/build.js && tools/webkit-host/run.sh all",
    "safari": "sh scripts/safari.sh",
    "log:app": "scripts/margin-log.sh",
    "fit-check": "node tools/fit-check/nightly.mjs"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "playwright": "1.63.0",
    "typescript": "7.0.2"
  }
}
