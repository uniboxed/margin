{
  "manifest_version": 3,
  "name": "focus-probe",
  "version": "1.0",
  "permissions": ["tabs", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "sw.js" },
  "chrome_url_overrides": { "newtab": "ntp.html" },
  "content_scripts": [{ "matches": ["http://127.0.0.1/*"], "js": ["cs.js"], "run_at": "document_idle" }]
}
