{
  "manifest_version": 3,
  "name": "Margin iframe-shell prototype",
  "version": "0.1.0",
  "description": "Same-origin iframe shell: sidebar + the page in a same-origin iframe.",
  "permissions": [
    "declarativeNetRequest",
    "storage"
  ],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "bg.js"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "framing",
        "enabled": false,
        "path": "rules.json"
      },
      {
        "id": "postmark",
        "enabled": true,
        "path": "rules-post.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "shell.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "frame.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}