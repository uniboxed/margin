{
  "manifest_version": 3,
  "name": "r-nav probe",
  "version": "1.0",
  "permissions": ["webNavigation"],
  "host_permissions": ["http://localhost/*", "http://127.0.0.1/*"],
  "background": { "service_worker": "bg.js" },
  "content_scripts": [{
    "matches": ["http://localhost/*", "http://127.0.0.1/*"],
    "js": ["cs.js"],
    "all_frames": true,
    "run_at": "document_start"
  }]
}
