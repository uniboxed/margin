self.addEventListener('install',e=>self.skipWaiting());self.addEventListener('activate',e=>e.waitUntil(clients.claim()));self.addEventListener('fetch',e=>{if(e.request.url.includes('/sw-probe'))e.respondWith(new Response('from-sw'))});self.addEventListener('message',e=>{e.waitUntil(clients.matchAll({type:'window',includeUncontrolled:true}).then(cs=>e.source.postMessage(cs.map(c=>({url:new URL(c.url).pathname,frameType:c.frameType,focused:c.focused,visibility:c.visibilityState,isSender:c.id===e.source.id})))))});