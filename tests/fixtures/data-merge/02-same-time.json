    "items": {
      "pins": {
        "p1": { "updatedAt": 500, "value": { "spaceId": "work", "url": "https://a.test/", "title": "A renamed", "folderId": null, "pos": 0 } },
        "p2": { "updatedAt": 500, "deleted": true },
        "p3": { "updatedAt": 500, "deleted": true }
      }
    }
  }
