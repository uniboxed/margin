{
  "compilerOptions": {
    "noEmit": true,
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "lib": [
      "esnext",
      "dom",
      "dom.iterable",
      "webworker.importscripts"
    ],
    "strict": true,
    "skipLibCheck": true
  },
  "include": [
    "extension/**/*.ts",
    "app/shared/host/*.ts",
    "types/*.d.ts"
  ]
}
