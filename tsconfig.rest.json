// What tsconfig.tests.json doesn't check yet (GitHub issue #4): the theme browser tests (tests/theme/) and the box
// patterns' benchmarks (tests/box/*.mts), under the same `strict` with Node's types, with what they
// import. Not checked with tsc directly: scripts/tests-check.mts runs it and fails only on errors in the folders and
// files already brought up to it, so those can't slip back while the rest catches up.
{
  "extends": "./tsconfig.tests.json",
  "include": [
    "types/*.d.ts",
    "tests/**/*.ts",
    "tests/**/*.mts"
  ],
  "exclude": []
}
