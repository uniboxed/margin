// The unit test files themselves (GitHub issue #4), under the same `strict` with Node's types as the shared fakes
// (tsconfig.tests.json), with what they import. Not checked with tsc directly: scripts/tests-check.mts runs it and
// fails only on errors in the files already brought up to it, so those can't slip back while the rest catches up.
{
  "extends": "./tsconfig.tests.json",
  "include": [
    "types/*.d.ts",
    "tests/fake-app.ts",
    "tests/fake-browser.ts",
    "tests/fake-clock.ts",
    "tests/ui/fixtures.ts",
    "tests/fixtures/*.ts",
    "tests/*.test.ts",
    "tests/security/*.ts",
    "extension/engines/**/tests/*.test.ts"
  ],
  "exclude": []
}
