// The tests and tools, checked against the real types under the same `strict` (in npm test and npm run typecheck):
// every file in tests/ (the shared fakes and harnesses, the unit tests, the theme and e2e browser tests — checked here,
// run only by their own scripts — the e2e test site, the box patterns' benchmarks), the engines' tests/, scripts/ and
// tools/ (their TypeScript), with what they import: the extension's files again. Folders by glob, so a new file there
// is checked at once (GitHub issue #4). With Node's types: they run in Node (the harnesses' and the tests' page
// functions run in a page, and are checked against the DOM's as well).
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["node"]
  },
  "include": [
    "types/*.d.ts",
    "tests/**/*.ts",
    "tests/**/*.mts",
    "extension/engines/**/tests/*.test.ts",
    "scripts/*.ts",
    "scripts/*.mts",
    "tools/**/*.ts",
    "tools/**/*.mts"
  ],
  "exclude": []
}
