// The tests, checked against the real types under the same `strict` (in npm test and npm run typecheck): the shared
// fakes and harnesses and every unit test file (tests/*.test.ts, tests/security/, the engines' tests/), with what they
// import: the extension's files again, the e2e test site, the scripts under test. Folders by glob, so a new test file is
// checked at once. With Node's types: they run in Node (the theme harness and the e2e helpers' page functions run in a
// page, and are checked against the DOM's as well). What isn't here yet (the browser tests, scripts/, tools/):
// tsconfig.rest.json, held folder by folder as each is brought up to it (scripts/tests-check.mts, GitHub issue #4).
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["node"]
  },
  "include": [
    "types/*.d.ts",
    "tests/fake-app.ts",
    "tests/fake-browser.ts",
    "tests/fake-clock.ts",
    "tests/ui/fixtures.ts",
    "tests/fixtures/*.ts",
    "tests/theme/harness.ts",
    "tests/theme/package.ts",
    "tests/e2e/harness/*.ts",
    "tests/e2e/harness/*.mts",
    "tests/*.test.ts",
    "tests/security/*.ts",
    "extension/engines/**/tests/*.test.ts"
  ],
  "exclude": []
}
