// The tests and tools, checked against the real types under the same `strict` (in npm test and npm run typecheck): the
// shared fakes and harnesses, every unit test file (tests/*.test.ts, tests/security/, the engines' tests/), scripts/
// and tools/ (their TypeScript), with what they import: the extension's files again, the e2e test site. Folders by
// glob, so a new file there is checked at once. With Node's types: they run in Node (the theme harness and the e2e
// helpers' page functions run in a page, and are checked against the DOM's as well). What isn't here yet (the browser
// tests):
// tsconfig.rest.json, held folder by folder as each is brought up to it (scripts/tests-check.mts, GitHub issue #4).
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["node"]
  },
  "include": [
    "types/*.d.ts",
    "tests/fake-app.ts",
    "tests/fake-browser.ts",
    "tests/fake-clock.ts",
    "tests/ui/fixtures.ts",
    "tests/fixtures/*.ts",
    "tests/theme/harness.ts",
    "tests/theme/package.ts",
    "tests/e2e/harness/*.ts",
    "tests/e2e/harness/*.mts",
    "tests/*.test.ts",
    "tests/security/*.ts",
    "extension/engines/**/tests/*.test.ts",
    "scripts/*.ts",
    "scripts/*.mts",
    "tools/**/*.ts",
    "tools/**/*.mts"
  ],
  "exclude": []
}
